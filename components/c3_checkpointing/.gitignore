# Raw datasets (never commit participant data)
data/raw/**
!data/raw/**/

# Processed trial-level data (derived from participant data)
data/processed/**

# Model files and weights
models/*.pkl
models/*/
*.safetensors
*.bin

# Data/archive formats
*.csv
*.xlsx
*.sav
*.zip

# Local demo databases
*.db
*.sqlite3

# Keep placeholder files committable
!.gitkeep
!**/.gitkeep
