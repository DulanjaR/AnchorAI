{
  "source": "anchor-ai-component1 backend/tests/api/{basics,tasks,mvds,reviews}.test.js (Task 3, approved 8 Oct 2026). Golden flows S1-S16 over HTTP are driven from scenarios/*.json, not repeated here.",
  "format": "See ../README.md. Each case starts with an empty store and a fixed clock at `now` (Asia/Colombo). Paths use the /api prefix of docs/API.md.",
  "defaultNow": "2026-10-07T09:00",
  "templates": {
    "task": {
      "title": "Read lecture notes",
      "type": "Analog",
      "priority": "High",
      "estimatedHours": 2,
      "deadline": "2026-10-07T23:59",
      "plannedDate": "2026-10-07"
    },
    "disruption": {
      "date": "2026-10-07",
      "type": "power_outage",
      "start": "09:00",
      "timeLostMinutes": 180,
      "severity": 2,
      "confirmed": true
    }
  },
  "fixtures": {
    "readyDay": [
      { "as": "u1", "method": "PUT", "path": "/api/me/settings", "body": { "workStart": "09:00", "workEnd": "18:00" }, "expect": { "status": 200 } },
      { "as": "u1", "method": "POST", "path": "/api/protected-blocks", "body": { "label": "Lunch", "start": "12:30", "end": "13:30" }, "expect": { "status": 201 } },
      { "as": "u1", "method": "POST", "path": "/api/tasks", "body": { "$task": { "title": "Reading", "plannedStart": "09:00", "plannedEnd": "11:00" } }, "expect": { "status": 201 }, "save": "reading" },
      { "as": "u1", "method": "POST", "path": "/api/tasks", "body": { "$task": { "title": "Coding", "type": "Digital", "estimatedHours": 1.5, "plannedStart": "11:00", "plannedEnd": "12:30" } }, "expect": { "status": 201 }, "save": "coding" },
      { "as": "u1", "method": "POST", "path": "/api/disruptions", "body": { "$disruption": {} }, "expect": { "status": 201 }, "save": "report" }
    ],
    "dayWithTasks": [
      { "as": "u1", "method": "POST", "path": "/api/tasks", "body": { "$task": { "title": "A" } }, "expect": { "status": 201 }, "save": "a" },
      { "as": "u1", "method": "POST", "path": "/api/tasks", "body": { "$task": { "title": "B" } }, "expect": { "status": 201 }, "save": "b" },
      { "as": "u1", "method": "POST", "path": "/api/tasks", "body": { "$task": { "title": "C" } }, "expect": { "status": 201 }, "save": "c" }
    ]
  },
  "cases": [
    {
