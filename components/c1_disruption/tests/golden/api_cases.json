        { "as": "u1", "method": "POST", "path": "/api/protected-blocks", "body": { "label": "X", "start": "12:00", "end": "12:00" }, "expect": { "status": 400 } },
        { "as": "u1", "method": "POST", "path": "/api/protected-blocks", "body": { "label": "X", "start": "12:00", "end": "13:00", "colour": "red" }, "expect": { "status": 400 } }
      ]
    },
    {
