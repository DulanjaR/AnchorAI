    { "id": "tasks.invalid_priority", "steps": [{ "as": "u1", "method": "POST", "path": "/api/tasks", "body": { "$task": { "priority": "Urgent" } }, "expect": { "status": 400, "messageRegex": "priority" } }] },
    { "id": "tasks.invalid_hours", "steps": [{ "as": "u1", "method": "POST", "path": "/api/tasks", "body": { "$task": { "estimatedHours": 0 } }, "expect": { "status": 400, "messageRegex": "estimatedHours" } }] },
    { "id": "tasks.invalid_deadline", "steps": [{ "as": "u1", "method": "POST", "path": "/api/tasks", "body": { "$task": { "deadline": "2026-10-07" } }, "expect": { "status": 400, "messageRegex": "deadline" } }] },
