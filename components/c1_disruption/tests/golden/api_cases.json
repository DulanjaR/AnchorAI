    },
    {
      "id": "basics.no_user_401",
      "steps": [
        { "as": null, "method": "GET", "path": "/api/tasks", "expect": { "status": 401, "equals": { "error": { "code": "NO_USER", "message": "<any-string>" } } } }
      ]
    },
    {
      "id": "basics.unknown_route_404",
      "steps": [
        { "as": "u1", "method": "GET", "path": "/api/nope", "expect": { "status": 404, "errorCode": "NOT_FOUND" } }
      ]
    },
    {
      "id": "basics.malformed_json_400",
      "steps": [
        { "as": "u1", "method": "POST", "path": "/api/tasks", "headers": { "Content-Type": "application/json" }, "rawBody": "{\"title\": ", "expect": { "status": 400, "errorCode": "INVALID_JSON" } }
      ]
    },
    {
